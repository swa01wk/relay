# Copy to .env and fill in (never commit .env)
# Used by: docker compose in this directory

# Agent LLM (Phase 1+ text; Phase 4+ voice streaming)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
RELAY_OPENAI_MODEL=gpt-5.4-mini

# Voice (Phase 3+)
DEEPGRAM_API_KEY=
# Speech recognition. Use a nova-3 model (Flux models are not supported for recognition and fall
# back to nova-3-general). Language: en, en-US, en-IN (Indian English), multi (mixed languages, e.g. Hindi + English).
DEEPGRAM_STT_MODEL=nova-3-general
DEEPGRAM_STT_LANGUAGE=en
# Extra words to listen for in every session, comma-separated (agents add their own `keyterms`).
DEEPGRAM_STT_KEYTERMS=
DEEPGRAM_TTS_MODEL=flux-haley-en
DEEPGRAM_TTS_ENCODING=linear16
DEEPGRAM_TTS_SAMPLE_RATE=24000

# Turn detection (Phase 3) — hybrid = Silero VAD start + Pipecat Smart Turn v3 stop; silero = VAD-only
RELAY_TURN_DETECTOR=hybrid
RELAY_ENDPOINTING_SILENCE_MS=650
RELAY_VAD_MIN_VOLUME=0.35
RELAY_SMART_TURN_STOP_SECS=2.0
RELAY_SMART_TURN_PRE_SPEECH_MS=500
RELAY_USER_TURN_STOP_TIMEOUT_SECS=8
# Pipecat pipeline idle cancel (unset = Pipecat default 300s); voice uses mic/agent frames too
# RELAY_PIPELINE_IDLE_TIMEOUT_SECS=900
RELAY_DEEPGRAM_ENDPOINTING_MS=500
# Wait for late STT finals after Silero ENDPOINTING (0 = commit immediately)
RELAY_UTTERANCE_COMMIT_DELAY_MS=250
# Fallback if the turn detector never reports speech end; keep above RELAY_SMART_TURN_STOP_SECS + silence, or sentences are cut at pauses
RELAY_STT_FINAL_ENDPOINT_MS=3000
# How long a finished utterance waits for the final of words still being recognized
RELAY_STT_FINAL_WAIT_MS=1200

# SmallWebRTC (Phase 2) — STUN for NAT traversal; set RELAY_DISABLE_WEBRTC=1 to skip
RELAY_ICE_STUN_URL=stun:stun.l.google.com:19302
# Set to 1 to echo mic→speaker for media debugging (default off after connect verified)
# RELAY_WEBRTC_AUDIO_LOOPBACK=1

# Mortgage read tools (Phase 5) — compose sets http://mortgage-tools:8090 for gateway
# RELAY_MORTGAGE_TOOLS_URL=http://localhost:8090

# Already set in docker-compose.yml; override here if needed
# RELAY_DATABASE_URL=postgresql://relay:relay@postgres:5432/relay
# RELAY_REDIS_URL=redis://redis:6379/0

RELAY_DEV_TOKEN_SECRET=change-me

# Phase 9 — HITL commit (mortgage tools + UI approver proof)
RELAY_DEV_APPROVER_TOKEN=dev-approver
RELAY_MORTGAGE_COMMIT_TOKEN=dev-mortgage-commit
MORTGAGE_COMMIT_TOKEN=dev-mortgage-commit

# --- Observability (all optional; see packages/web-sdk/docs/03-reference.md#observability) ---
# USD per 1M tokens, by model id ("*" = fallback). Enables cost on usage metrics.
# RELAY_MODEL_PRICES={"gpt-4o-mini": {"input": 0.15, "cached_input": 0.075, "output": 0.60}}
# Prometheus scrape endpoint (GET /metrics) protected by a bearer token.
# RELAY_METRICS_TOKEN=
# Session inspector + audit trail at /admin, protected by this token.
# RELAY_ADMIN_TOKEN=
# OpenTelemetry traces (OTLP/HTTP collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# json = one JSON object per log line.
# RELAY_LOG_FORMAT=json
# Delete stored events older than N days; and what the event log may keep (text, data).
# RELAY_EVENT_RETENTION_DAYS=30
# RELAY_EVENT_STORE_REDACT=text,data

# --- Hosted accounts (see reference) ---
# Encrypts customers' model API keys at rest. Use a long random string and keep it forever:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# RELAY_SECRETS_KEY=
# Public address of the gateway, used in the `relay login` link.
# RELAY_PUBLIC_URL=https://relay.example.com
# Who may sign up: open | allowlist | closed, and the allowlist (emails and/or @domains).
# RELAY_SIGNUP=allowlist
# RELAY_SIGNUP_ALLOWLIST=you@example.com,@example.com
# Behind your own proxy (Caddy, nginx, ngrok): read client addresses from X-Forwarded-For.
# RELAY_TRUST_PROXY_HEADERS=1
# Emails (confirmation, password reset). Without RELAY_SMTP_HOST they are printed to the gateway log.
# RELAY_SMTP_HOST=smtp.example.com
# RELAY_SMTP_PORT=587
# RELAY_SMTP_USERNAME=
# RELAY_SMTP_PASSWORD=
# RELAY_EMAIL_FROM=Relay <no-reply@example.com>
