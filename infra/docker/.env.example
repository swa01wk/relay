# Copy to .env and fill in (never commit .env)
# Used by: docker compose in this directory

# Agent LLM (Phase 1+ text; Phase 4+ voice streaming)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
RELAY_OPENAI_MODEL=gpt-5.4-mini

# Voice (Phase 3+)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=flux-general-en
# Pipecat adapter uses Deepgram listen v1 — Flux is auto-mapped to nova-3-general at runtime.
# For native Flux v2, set RELAY_DEEPGRAM_STT_MODEL=nova-3-general explicitly.
DEEPGRAM_TTS_MODEL=flux-haley-en
DEEPGRAM_TTS_ENCODING=linear16
DEEPGRAM_TTS_SAMPLE_RATE=24000

# Turn detection (Phase 3) — hybrid = Silero VAD start + Pipecat Smart Turn v3 stop; silero = VAD-only
RELAY_TURN_DETECTOR=hybrid
RELAY_ENDPOINTING_SILENCE_MS=650
RELAY_VAD_MIN_VOLUME=0.35
RELAY_SMART_TURN_STOP_SECS=2.0
RELAY_SMART_TURN_PRE_SPEECH_MS=500
RELAY_USER_TURN_STOP_TIMEOUT_SECS=8
# Pipecat pipeline idle cancel (unset = Pipecat default 300s); voice uses mic/agent frames too
# RELAY_PIPELINE_IDLE_TIMEOUT_SECS=900
RELAY_DEEPGRAM_ENDPOINTING_MS=500
# Wait for late STT finals after Silero ENDPOINTING (0 = commit immediately)
RELAY_UTTERANCE_COMMIT_DELAY_MS=250
# If Silero never sends speech_end, commit after STT final + debounce (ms)
RELAY_STT_FINAL_ENDPOINT_MS=300

# SmallWebRTC (Phase 2) — STUN for NAT traversal; set RELAY_DISABLE_WEBRTC=1 to skip
RELAY_ICE_STUN_URL=stun:stun.l.google.com:19302
# Set to 1 to echo mic→speaker for media debugging (default off after connect verified)
# RELAY_WEBRTC_AUDIO_LOOPBACK=1

# Mortgage read tools (Phase 5) — compose sets http://mortgage-tools:8090 for gateway
# RELAY_MORTGAGE_TOOLS_URL=http://localhost:8090

# Already set in docker-compose.yml; override here if needed
# RELAY_DATABASE_URL=postgresql://relay:relay@postgres:5432/relay
# RELAY_REDIS_URL=redis://redis:6379/0

RELAY_DEV_TOKEN_SECRET=change-me

# Phase 9 — HITL commit (mortgage tools + UI approver proof)
RELAY_DEV_APPROVER_TOKEN=dev-approver
RELAY_MORTGAGE_COMMIT_TOKEN=dev-mortgage-commit
MORTGAGE_COMMIT_TOKEN=dev-mortgage-commit
