FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY examples/national-bank/tools /app/examples/national-bank/tools

RUN pip install --no-cache-dir -e /app/examples/national-bank/tools

ENV VNB_TOOLS_PORT=8096
EXPOSE 8096
CMD ["vnb-tools-api"]
