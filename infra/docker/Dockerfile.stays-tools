FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY examples/stays/tools /app/examples/stays/tools

RUN pip install --no-cache-dir -e /app/examples/stays/tools

ENV STAYS_TOOLS_PORT=8094
EXPOSE 8094
CMD ["stays-tools-api"]
