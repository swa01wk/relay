FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY examples/sales-crm/tools /app/examples/sales-crm/tools

RUN pip install --no-cache-dir -e /app/examples/sales-crm/tools

ENV CRM_TOOLS_PORT=8091
EXPOSE 8091
CMD ["crm-tools-api"]
