# One image per Next.js app (website or example), built from the pnpm workspace.
# Used by docker-compose.prod.yml; set APP (package name) and APP_DIR (its folder).
# NEXT_PUBLIC_* values are compiled into the browser code, so they are build arguments:
# change one → rebuild the image.

FROM node:22-slim AS build
RUN corepack enable
WORKDIR /repo
COPY . .

ARG APP
ARG APP_DIR
ARG NEXT_PUBLIC_GATEWAY_URL
ARG NEXT_PUBLIC_RELAY_SANDBOX
ARG RELAY_SANDBOX_FRAME_ANCESTORS
ARG NEXT_PUBLIC_EXAMPLE_SALES_CRM_URL
ARG NEXT_PUBLIC_EXAMPLE_MORTGAGE_URL
ARG NEXT_PUBLIC_EXAMPLE_STOREFRONT_URL
ARG NEXT_PUBLIC_EXAMPLE_BUS_BOOKING_URL
ARG NEXT_PUBLIC_EXAMPLE_STAYS_URL
ENV NEXT_TELEMETRY_DISABLED=1 \
    RELAY_NEXT_STANDALONE=1 \
    NEXT_PUBLIC_GATEWAY_URL=${NEXT_PUBLIC_GATEWAY_URL} \
    NEXT_PUBLIC_RELAY_SANDBOX=${NEXT_PUBLIC_RELAY_SANDBOX} \
    RELAY_SANDBOX_FRAME_ANCESTORS=${RELAY_SANDBOX_FRAME_ANCESTORS} \
    NEXT_PUBLIC_EXAMPLE_SALES_CRM_URL=${NEXT_PUBLIC_EXAMPLE_SALES_CRM_URL} \
    NEXT_PUBLIC_EXAMPLE_MORTGAGE_URL=${NEXT_PUBLIC_EXAMPLE_MORTGAGE_URL} \
    NEXT_PUBLIC_EXAMPLE_STOREFRONT_URL=${NEXT_PUBLIC_EXAMPLE_STOREFRONT_URL} \
    NEXT_PUBLIC_EXAMPLE_BUS_BOOKING_URL=${NEXT_PUBLIC_EXAMPLE_BUS_BOOKING_URL} \
    NEXT_PUBLIC_EXAMPLE_STAYS_URL=${NEXT_PUBLIC_EXAMPLE_STAYS_URL}

# The app and the workspace packages it uses (the SDK builds itself on install).
RUN pnpm install --frozen-lockfile --filter "${APP}..."
RUN pnpm --filter "${APP}" build
# A fresh clone has no empty public/ folder (git does not keep empty folders).
RUN mkdir -p "${APP_DIR}/public"

FROM node:22-slim
ARG APP_DIR
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    APP_DIR=${APP_DIR}
WORKDIR /app
COPY --from=build --chown=node:node /repo/${APP_DIR}/.next/standalone ./
COPY --from=build --chown=node:node /repo/${APP_DIR}/.next/static ./${APP_DIR}/.next/static
COPY --from=build --chown=node:node /repo/${APP_DIR}/public ./${APP_DIR}/public
USER node
EXPOSE 3000
CMD ["sh", "-c", "exec node \"$APP_DIR/server.js\""]
