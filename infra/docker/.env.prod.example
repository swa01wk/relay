# Production settings for docker-compose.prod.yml. Copy to .env.prod (never commit it) and fill in.
# Generate random values with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# After edits: infra/docker/prod.sh up -d   (rebuild with --build when DOMAIN changes:
# the web apps compile it in).

# --- Server ---
# Your domain. DNS: DOMAIN, www, api, crm, shop, bus, stays and bank (A/AAAA) → this server.
DOMAIN=example.com
# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=

# --- Secrets (random, required) ---
POSTGRES_PASSWORD=
# Encrypts customers' model keys at rest. Keep it forever: changing or losing it makes stored
# secrets unreadable.
RELAY_SECRETS_KEY=
# Voice relay (coturn): the gateway signs browsers' short-lived TURN credentials with it.
RELAY_TURN_SECRET=

# --- Model + speech ---
# Used by the example agents (every Experience Center visitor). Give it a spending cap at OpenAI.
OPENAI_API_KEY=
RELAY_OPENAI_MODEL=gpt-5.4-mini
RELAY_OPENAI_REASONING_EFFORT=none
RELAY_OPENAI_HEDGE_AFTER_SECS=3
RELAY_END_TURN_AFTER_DISPLAY=1
# Voice (speech-to-text and text-to-speech for every project). Text works without it.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3-general
DEEPGRAM_STT_LANGUAGE=en-IN
DEEPGRAM_TTS_MODEL=flux-cole-en
DEEPGRAM_TTS_ENCODING=linear16
DEEPGRAM_TTS_SAMPLE_RATE=24000
RELAY_ICE_STUN_URL=stun:stun.l.google.com:19302
# Turn detection and endpointing (same values as local development).
RELAY_TURN_DETECTOR=hybrid
RELAY_ENDPOINTING_SILENCE_MS=650
RELAY_VAD_MIN_VOLUME=0.35
RELAY_SMART_TURN_STOP_SECS=2.0
RELAY_SMART_TURN_PRE_SPEECH_MS=500
RELAY_USER_TURN_STOP_TIMEOUT_SECS=8
RELAY_DEEPGRAM_ENDPOINTING_MS=500
RELAY_UTTERANCE_COMMIT_DELAY_MS=150
RELAY_STT_FINAL_ENDPOINT_MS=250

# --- Accounts (relay login) ---
# Who may sign up: allowlist (only RELAY_SIGNUP_ALLOWLIST) or closed. Never open on a public server.
RELAY_SIGNUP=allowlist
RELAY_SIGNUP_ALLOWLIST=
RELAY_EMAIL_VERIFICATION=required
# Confirmation and password-reset emails. Without SMTP they go to the gateway log, which anyone
# who can read the log could use to take over accounts: set it up before inviting anyone.
RELAY_SMTP_HOST=
RELAY_SMTP_PORT=587
RELAY_SMTP_STARTTLS=1
RELAY_SMTP_USERNAME=
RELAY_SMTP_PASSWORD=
RELAY_EMAIL_FROM=Relay <no-reply@example.com>

# --- Operator endpoints (random; leave empty to keep them off) ---
# Session inspector at https://api.<DOMAIN>/admin.
RELAY_ADMIN_TOKEN=
# Prometheus scrape endpoint https://api.<DOMAIN>/metrics.
RELAY_METRICS_TOKEN=

# --- Event log ---
RELAY_EVENT_RETENTION_DAYS=30
# RELAY_EVENT_STORE_REDACT=text,data
# USD per 1M tokens, from your provider's price list; enables cost in /admin and relay usage.
# RELAY_MODEL_PRICES={"<model>": {"input": 0, "cached_input": 0, "output": 0}}
