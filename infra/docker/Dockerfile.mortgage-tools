FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY examples/mortgage-servicing/tools /app/examples/mortgage-servicing/tools

RUN pip install --no-cache-dir -e /app/examples/mortgage-servicing/tools

ENV MORTGAGE_TOOLS_PORT=8090
EXPOSE 8090
CMD ["mortgage-tools-api"]
