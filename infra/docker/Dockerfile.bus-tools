FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY examples/bus-booking/tools /app/examples/bus-booking/tools

RUN pip install --no-cache-dir -e /app/examples/bus-booking/tools

ENV BUS_TOOLS_PORT=8093
EXPOSE 8093
CMD ["bus-tools-api"]
