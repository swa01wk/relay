FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY examples/banking/tools /app/examples/banking/tools

RUN pip install --no-cache-dir -e /app/examples/banking/tools

ENV BANK_TOOLS_PORT=8095
EXPOSE 8095
CMD ["bank-tools-api"]
