# Relay gateway, as the browser reaches it (WebSocket + WebRTC) and as this app's server reaches it.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
RELAY_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_AGENT_ID=bus-booking
# Sessions are started on this app's server for the signed-in traveller (lib/session.ts).
# Hosted gateway: the project's secret key (`relay keys create --kind secret`) — server-side only.
# Leave empty against a local dev gateway (RELAY_DEV_SESSIONS=1); the project id below is then used.
RELAY_SECRET_KEY=
NEXT_PUBLIC_PROJECT_ID=proj-bus-booking
# Server-side only: the booking API (examples/bus-booking/tools)
BUS_API_URL=http://localhost:8093
BUS_API_TOKEN=
# Experience Center: one private copy of the site per visitor (see docs/experience-center.md)
NEXT_PUBLIC_RELAY_SANDBOX=
RELAY_SANDBOX_FRAME_ANCESTORS=
