# Relay gateway (WebSocket + WebRTC) and the agent this app talks to
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
# Publishable key from `relay keys create --kind publishable` (safe in the browser).
# Leave empty against a local dev gateway (RELAY_DEV_SESSIONS=1); the project id below is then used.
NEXT_PUBLIC_RELAY_API_KEY=
NEXT_PUBLIC_PROJECT_ID=proj-sales-crm
NEXT_PUBLIC_AGENT_ID=sales-crm
# Server-side only: CRM tools API used to render the dashboard
CRM_TOOLS_URL=http://localhost:8091
